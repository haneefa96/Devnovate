# Backend-only credentials. Copy to backend/.env; never commit backend/.env.
# Leave secrets empty in this template.

# Hindsight Cloud (optional local URL can be used instead)
HINDSIGHT_API_KEY=
HINDSIGHT_BASE_URL=
HINDSIGHT_LOCAL_URL=
HINDSIGHT_TIMEOUT=30

# Groq
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com
GROQ_AGENT_MODEL=openai/gpt-oss-120b
GROQ_CUSTOMER_MODEL=qwen/qwen3-32b

# Band remote agents (each agent needs its own API key)
BAND_ROOM_ID=
BAND_COLLECTOR_AGENT_ID=
BAND_COLLECTOR_API_KEY=
BAND_RISK_AGENT_ID=
BAND_RISK_API_KEY=

# Legacy Band bridge configuration; the bridge currently does not post messages.
BAND_API_KEY=
BAND_AGENT_ID=

# Application
APP_ENV=development
DEBUG=true
LOG_LEVEL=INFO
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# Local SQLite database; do not change this to Supabase for this task.
DATABASE_URL=sqlite:///./munshi.db
SIM_MODE=true
